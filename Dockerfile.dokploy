# syntax=docker/dockerfile:1-labs@sha256:63e440b412b6acba117974e793b7e7f702e58ee65e044bdff1b8d388ee0d853b

# Self-contained production Dockerfile for Dokploy (personal-fork deploys).
#
# Dockerfile.production's `full` target (server + built Admin UI) expects Admin
# to already be built and injected into the build context at
# ghost/core/core/built/admin — upstream's CI builds Admin in a separate job and
# copies it in before running `docker build --target full` (see
# .github/workflows/ci.yml, job_build_admin + job_docker). Dokploy just clones
# this repo and runs `docker build`, so that injection step doesn't exist here.
#
# This file adds an `admin-build` stage that builds Admin in-container, then
# feeds it into the same `deploy`/`core`/`full` stages as Dockerfile.production.
# It's a separate file (not a modification of Dockerfile.production) so syncing
# from upstream never conflicts here — re-diff this file against
# Dockerfile.production after a large upstream Docker-build change.
#
# Build (from repo root): docker build -f Dockerfile.dokploy -t ghost-dokploy .
# Dokploy: point the Application/Compose build at this file, target `full`.

ARG NODE_VERSION=22.23.1

# ---- admin-build: build the Admin UI in-container ----
# Needs the full workspace install (Admin's nx build fans out across
# ghost-admin, admin-x-*, shade, and koenig-lexical via nx dependsOn, not
# package deps), unlike the `ghost`-filtered install the deploy stage uses.
FROM node:$NODE_VERSION-bookworm-slim AS admin-build

WORKDIR /build

RUN corepack enable

COPY . .

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    pnpm install --frozen-lockfile --prefer-offline

# Builds apps/admin/dist AND ghost/core/core/built/admin.
RUN pnpm nx run @tryghost/admin:build

# ---- deploy: build closure + self-contained app dir (build-only, not shipped) ----
FROM node:$NODE_VERSION-bookworm-slim AS deploy

WORKDIR /build

RUN corepack enable

COPY --exclude=ghost/core/core/built . .

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    pnpm install --filter "ghost..." --frozen-lockfile --prefer-offline

RUN pnpm --filter-prod "ghost^..." -r run build && \
    pnpm --filter ghost run build:tsc && \
    pnpm --filter ghost run build:assets

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    pnpm --filter=ghost --config.inject-workspace-packages=true deploy --prod /home/ghost

RUN node ghost/core/scripts/prune.mts /home/ghost --profile=image --report=/image-report.json

RUN cd /home/ghost && node -e "require('better-sqlite3'); console.log('better-sqlite3 OK')"

# ---- core: server + production deps ----
FROM node:$NODE_VERSION-bookworm-slim AS core

ENV NODE_ENV=production

RUN apt-get update && \
    apt-get install -y --no-install-recommends libjemalloc2 fontconfig && \
    rm -rf /var/lib/apt/lists/* && \
    groupmod -g 1001 node && \
    usermod -u 1001 node && \
    adduser --disabled-password --gecos "" -u 1000 ghost

WORKDIR /home/ghost

COPY --chown=nobody:nogroup --from=deploy /home/ghost ./

RUN mkdir -p default log && \
    cp -a content base_content && \
    cp -a content/themes/casper default/casper && \
    ([ -d content/themes/source ] && cp -a content/themes/source default/source || true) && \
    chown ghost:ghost /home/ghost && \
    chown nobody:nogroup default && \
    chown -R ghost:ghost content log

ARG GHOST_BUILD_VERSION=""
ENV GHOST_BUILD_VERSION=${GHOST_BUILD_VERSION}

USER ghost
ENV LD_PRELOAD=libjemalloc.so.2

EXPOSE 2368

CMD ["node", "index.js"]

# ---- full: core + admin, built in-container above instead of injected by CI ----
FROM core AS full

COPY --chown=nobody:nogroup --from=admin-build /build/ghost/core/core/built/admin core/built/admin
