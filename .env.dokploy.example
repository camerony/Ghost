# Environment variables for docker-compose.dokploy.yml
## Set these in Dokploy's Environment tab for the compose service (or copy this
## file to .env.dokploy locally and use `docker compose --env-file` to test).
## Never commit the real values.

# Public URL Ghost is served at, including protocol. Required.
GHOST_URL=https://your-domain.example

# MySQL credentials. Required. Use a generated password, not a placeholder.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=ghost
MYSQL_PASSWORD=
MYSQL_DATABASE=ghost

# Outgoing mail (needed for member signup/magic-link emails). See
# https://ghost.org/docs/config/#mail for transport options; Direct sends
# without an SMTP relay and is unreliable for production — set these for a
# real provider (e.g. Mailgun SMTP) instead of leaving Direct as the transport.
MAIL_TRANSPORT=SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
