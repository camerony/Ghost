# Copy to .env (for local testing) or set these as environment variables in
# whatever launches this MCP server (e.g. Claude Code's mcp config).

# Your Ghost site's base URL, no path suffix.
GHOST_ADMIN_API_URL=https://your-site.example

# From Ghost Admin -> Settings -> Advanced -> Integrations -> Add custom
# integration -> Admin API Key. Format is "id:secret".
GHOST_ADMIN_API_KEY=
